{
  "name": "dsh-sync-hub",
  "version": "0.10.0",
  "description": "sync-hub console tools + settings card for DSH: sync, backups, sessions, env, plugins, AI toolchain, credentials, new-machine bootstrap. 跨机记忆同步中枢插件：全套控制台功能 + 设置页卡片 + 新机自助接入。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sync-hub",
    "tool"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
