{
  "name": "dsh-sync-hub",
  "version": "2.3.0",
  "description": "DSH 同步中枢：侧栏入口 + 四页信息面板（状态 / 内容 / 知识库 / 设置）。两台电脑的 AI 记忆 / 技能 / 配置同步。数据走 Gitee 私有中枢，插件代码走 GitHub 发布。会话为单向归档，按工作区归组，缺失目录可一键创建。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sync-hub",
    "sidebar-panel"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "immediately": false
    }
  }
}
